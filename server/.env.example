# ---- Server ----
# Node listens privately on 4000; the IIS API site can proxy to this port.
PORT=4000
NODE_ENV=development

# Leave MONGODB_URI empty to auto-start an in-memory MongoDB (dev only).
# Example: mongodb://127.0.0.1:27017/zoomit
MONGODB_URI=

JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# Comma separated list of allowed origins for CORS (4200 dev client, 8085 IIS client)
CORS_ORIGIN=http://localhost:4200,http://localhost:8085

# For IIS, set this to the externally reachable API site URL (for example
# http://localhost:8086) so generated upload URLs use the IIS binding.
PUBLIC_URL=http://localhost:4000
